<?xml version="1.0" encoding="UTF-8"?>
<!--
  Extension Point AutoApp_JobTab, a DRAFT: an "AutoApp" tab on the edit page of job
  definitions, holding AutoApp's job editor. See ../README.md.

  The extensionpoint, extension, description, translations and csp elements follow the
  DTD published in "Extending Redwood Server Functionality with Extension Points"
  (RunMyJobs 2025.4). The objectpage element is NOT in the public DTD: its name and
  attributes below are a guess from "Extending Edit Pages with ObjectPageExtensionPoint",
  which only says that extends accepts an ObjectPage element, that a page can be replaced
  (first), be the only tab (single), gain a tab (add) or be taken over (whole), that it
  is matched by object type, and that a priority settles conflicts. TO CONFIRM.
-->
<!DOCTYPE extensionpoint PUBLIC "-//Redwood//DTD Extension Point 1.0//EN" "extensionpoint.dtd">
<extensionpoint version="0.1">
  <extension name="AutoApp_JobTab" output="tabpage" sessionpersistence="StatefulMultiple">
    <description>AutoApp: the steps, endpoints and variables of the AutoApp job this job definition runs</description>
    <extends>
      <!-- TO CONFIRM: element and attribute names. Only definitions of the AUTOAPP kind should get the tab:
           here by filtering on the definition's name prefix; a parameter or an object tag may suit better. -->
      <objectpage objecttype="JobDefinition" type="add" priority="10">
        <filter field="Name" compare="EQUALS">AUTOAPP_*</filter>
      </objectpage>
    </extends>
    <translations default="en">
      <translation lang="en">AutoApp</translation>
    </translations>
  </extension>
  <!-- Since 9.2.10, RunMyJobs' Content-Security-Policy blocks external content unless the descriptor
       allows it. AutoApp's address goes here. TO CONFIRM: the directive name RunMyJobs expects. -->
  <csp>
    <directive name="frame-src">
      <source>https://autoapp.example.com</source>
    </directive>
  </csp>
</extensionpoint>
