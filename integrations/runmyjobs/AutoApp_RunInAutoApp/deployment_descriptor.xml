<?xml version="1.0" encoding="UTF-8"?>
<!--
  Extension Point AutoApp_RunInAutoApp, a DRAFT: "Files in AutoApp" and "Log in AutoApp"
  on the context menu of a job (a run), opening AutoApp's Operations Log or job log for
  that run in a pop-up. See ../README.md.

  Follows the DTD and the CountObjects example published in "Extending Redwood Server
  Functionality with Extension Points" and "Creating Extension Points" (RunMyJobs 2025.4):
  popupmenu, model and output="popup" are as documented there.
-->
<!DOCTYPE extensionpoint PUBLIC "-//Redwood//DTD Extension Point 1.0//EN" "extensionpoint.dtd">
<extensionpoint version="0.1">
  <extension name="AutoApp_Files" output="popup">
    <description>The files this run handled, and each file's route, in AutoApp's Operations Log</description>
    <extends>
      <!-- Only runs of AutoApp job definitions. TO CONFIRM: the field path to the job's definition name. -->
      <popupmenu objecttype="Job" multiselect="false">
        <filter field="JobDefinition.Name" compare="EQUALS">AUTOAPP_*</filter>
      </popupmenu>
    </extends>
    <parameters>
      <model name="Job" />
    </parameters>
    <translations default="en">
      <translation lang="en">Files in AutoApp</translation>
    </translations>
  </extension>
  <extension name="AutoApp_Log" output="popup">
    <description>This run's job log, as AutoApp keeps it</description>
    <extends>
      <popupmenu objecttype="Job" multiselect="false">
        <filter field="JobDefinition.Name" compare="EQUALS">AUTOAPP_*</filter>
      </popupmenu>
    </extends>
    <parameters>
      <model name="Job" />
    </parameters>
    <translations default="en">
      <translation lang="en">Log in AutoApp</translation>
    </translations>
  </extension>
  <csp>
    <directive name="frame-src">
      <source>https://autoapp.example.com</source>
    </directive>
  </csp>
</extensionpoint>
